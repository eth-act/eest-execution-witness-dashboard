{
  "clients": {
    "besu": {
      "hive_client": "besu",
      "dockerfile": "git",
      "nametag": "rlp-engineapi",
      "hive_parallelism": 8,
      "repo": "https://github.com/besu-eth/besu.git",
      "github": "besu-eth/besu",
      "ref": "main",
      "transport": "json-rpc-rlp"
    },
    "ethrex": {
      "hive_client": "ethrex",
      "dockerfile": "git",
      "nametag": "rlp-engineapi",
      "hive_parallelism": 8,
      "repo": "https://github.com/lambdaclass/ethrex.git",
      "github": "lambdaclass/ethrex",
      "ref": "v29.0.0",
      "transport": "json-rpc-rlp"
    },
    "go-ethereum": {
      "hive_client": "go-ethereum",
      "dockerfile": "git",
      "nametag": "rlp-engineapi",
      "hive_parallelism": 8,
      "repo": "https://github.com/ethereum/go-ethereum.git",
      "github": "ethereum/go-ethereum",
      "ref": "v1.17.7",
      "transport": "json-rpc-rlp"
    },
    "nimbus-el": {
      "hive_client": "nimbus-el",
      "dockerfile": "git",
      "nametag": "rlp-engineapi",
      "hive_parallelism": 8,
      "repo": "https://github.com/status-im/nimbus-eth1.git",
      "github": "status-im/nimbus-eth1",
      "ref": "master",
      "managed_patch": "nimbus-skip-lfs",
      "transport": "json-rpc-rlp"
    },
    "nethermind": {
      "hive_client": "nethermind",
      "dockerfile": "git",
      "nametag": "rlp-engineapi",
      "hive_parallelism": 8,
      "repo": "https://github.com/NethermindEth/nethermind.git",
      "github": "NethermindEth/nethermind",
      "ref": "2.1.0",
      "transport": "json-rpc-rlp"
    },
    "nimbus-el-rest": {
      "hive_client": "nimbus-el",
      "dockerfile": "git",
      "nametag": "rest-ssz",
      "hive_parallelism": 8,
      "repo": "https://github.com/status-im/nimbus-eth1.git",
      "github": "status-im/nimbus-eth1",
      "ref": "witness-rest-ssz-endpoint",
      "managed_patch": "nimbus-skip-lfs",
      "transport": "rest-ssz",
      "build_args": {
        "engine_api_rest": "true"
      }
    }
  }
}
